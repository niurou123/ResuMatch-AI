{
  "manifest_version": 3,
  "name": "ResuMatch - 网申面试助手",
  "version": "2.0.0",
  "description": "AI驱动的网申自动填充和面试准备助手。上传简历，一键填表，智能问答。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ResuMatch AI"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/sidebar.html", "resume-editor.html", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}

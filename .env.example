# ResuMatch AI 环境变量模板
#
# 用法：cp .env.example .env，然后只需填 DEEPSEEK_API_KEY。
# 其余项与 src/config.py 的默认值一致——改了这里就等于改了运行时行为，
# 所以除非确有需要，保持注释状态即可（不改动 = 用 config.py 的默认值）。
#
# 注意：文件必须保存为 UTF-8（无 BOM 也可）。中文 Windows 上若被存成 GBK，
# 含中文的注释会触发 UnicodeDecodeError（参见 BUG_LOG.md 案例 10）。

# ===== DeepSeek API（必填） =====
DEEPSEEK_API_KEY=sk-your-api-key-here
# 本项目锁定 deepseek-v4-pro，不要改成 deepseek-chat 等其他模型
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=60

# ===== 服务配置 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# DEBUG=true 时 uvicorn 开启 --reload
DEBUG=false

# ===== 数据路径 =====
MILVUS_DB_PATH=data/milvus_resumatch.db
CHROMA_DB_PATH=data/chroma_db
RESUME_UPLOAD_PATH=data/resumes
LOG_DIR=logs/

# ===== 嵌入模型（与 config.py 一致：bge-small-zh / 512 维） =====
EMBEDDING_MODEL=BAAI/bge-small-zh
EMBEDDING_DIM=512

# ===== 检索配置 =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-base

# ===== 简历解析配置 =====
CHUNK_SIZE=3
PARENT_CHUNK_MIN_LENGTH=50
SUPPORTED_RESUME_FORMATS=pdf,docx,md,txt

# ===== 推理配置 =====
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.95

# ===== 工作流配置 =====
MAX_REVISION_ROUNDS=3

# ===== Redis（会话持久化 + LLM 语义缓存；未启动时自动降级内存） =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SESSION=3600
REDIS_TTL_CACHE=86400
REDIS_CACHE_ENABLED=true
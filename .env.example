# DeepSeek API
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=60

# 检索配置
FAISS_INDEX_PATH=data/embeddings/faiss.index
BM25_INDEX_PATH=data/embeddings/bm25.pkl
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# LoRA 微调
LORA_MODEL_PATH=models/lora_model
LORA_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
LORA_RANK=64
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# 训练配置
TRAINING_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=5e-4
NUM_EPOCHS=3
MAX_STEPS=-1
WARMUP_STEPS=500
WEIGHT_DECAY=0.01
MIXED_PRECISION=bfloat16

# GPU 配置
DEVICE=cuda
NUM_GPUS=auto
MAX_BATCH_SIZE=16
USE_FLASH_ATTENTION=true
USE_GRADIENT_CHECKPOINTING=true
DISTRIBUTED_TRAINING=true

# 推理配置
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=50
REPETITION_PENALTY=1.0
LENGTH_PENALTY=1.0

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# 数据库配置
FAISS_USE_CPU=false
FAISS_OMP_NUM_THREADS=8

# 题库配置
QUESTIONS_DATASET_PATH=data/questions/all_questions.json
QUESTIONS_EMBEDDING_PATH=data/embeddings/questions_embeddings.pkl

# 评测配置
EVALUATION_METRICS=em,bleu,rouge,code_exec
CODE_EXEC_TIMEOUT=10

# 监控和日志
ENABLE_MONITORING=true
LOG_DIR=logs/
SAVE_INTERVAL=100
